+@skipUnlessDBFeature("supports_over_clause")
 class PrefetchLimitTests(TestDataMixin, TestCase):
+    def test_without_to_attr(self):
+        for model, relation, related_model in (
+            (Book, "authors", Author),
+            (Author, "books", Book),
+            (Book, "first_time_authors", Author),
+        ):
+            with self.subTest(relation=relation):
+                expected = {
+                    obj.pk: list(getattr(obj, relation).order_by("pk"))[1:2]
+                    for obj in model.objects.all()
+                }
+                queryset = related_model.objects.order_by("pk")[1:2]
+                prefetch = Prefetch(relation, queryset=queryset)
+                # Reusing the Prefetch must preserve the original slice.
+                for _ in range(2):
+                    with self.assertNumQueries(2):
+                        objects = list(model.objects.prefetch_related(prefetch))
+                    with self.assertNumQueries(0):
+                        for obj in objects:
+                            self.assertEqual(
+                                list(getattr(obj, relation).all()), expected[obj.pk]
+                            )
+                    self.assertEqual(queryset.query.low_mark, 1)
+                    self.assertEqual(queryset.query.high_mark, 2)
+
+    def test_slice_bounds(self):
+        authors = Author.objects.order_by("name")
+        for bounds in (slice(None, 2), slice(1, 3), slice(5, None), slice(0, 0)):
+            with self.subTest(bounds=bounds):
+                books = list(
+                    Book.objects.prefetch_related(
+                        Prefetch("authors", authors),
+                        Prefetch("authors", authors[bounds], to_attr="authors_sliced"),
+                    )
+                )
+                with self.assertNumQueries(0):
+                    for book in books:
+                        self.assertEqual(
+                            book.authors_sliced, list(book.authors.all())[bounds]
+                        )
+
+    def test_unordered(self):
+        with self.assertNumQueries(2):
+            books = list(
+                Book.objects.prefetch_related(
+                    Prefetch(
+                        "authors",
+                        Author.objects.order_by()[:1],
+                        to_attr="authors_sliced",
+                    )
+                )
+            )
+        for book in books:
+            self.assertEqual(len(book.authors_sliced), min(book.authors.count(), 1))
+            for author in book.authors_sliced:
+                self.assertIn(author, book.authors.all())
+
+    def test_unsupported_backend(self):
+        msg = (
