+    def test_slices_without_to_attr(self):
+        for model, relation, related in (
+            (Book, "authors", Author.objects.all()),
+            (Author, "books", Book.objects.order_by("title")),
+            (Book, "first_time_authors", Author.objects.order_by("-name")),
+        ):
+            for start, stop in ((0, 2), (1, 2), (1, None), (0, 0)):
+                with self.subTest(relation=relation, start=start, stop=stop):
+                    sliced = related[start:stop]
+                    with self.assertNumQueries(2 if stop == 0 else 3):
+                        objects = list(
+                            model.objects.prefetch_related(
+                                Prefetch(relation, related, to_attr="all_related"),
+                                Prefetch(relation, sliced),
+                            )
