+@skipUnlessDBFeature("supports_over_clause")
 class PrefetchLimitTests(TestDataMixin, TestCase):
+    def test_slices(self):
+        for relation in ("authors", "first_time_authors"):
+            for ordering in (("name",), ()):
+                authors = Author.objects.filter(name__in=["Anne", "Emily"]).order_by(
+                    *ordering
+                )
+                for start, stop in ((0, 1), (1, 2), (3, None), (0, 0)):
+                    with self.subTest(
+                        relation=relation, ordering=ordering, slice=(start, stop)
+                    ):
+                        sliced_authors = authors[start:stop]
+                        with self.assertNumQueries(2 if start == stop else 3):
+                            books = list(
+                                Book.objects.prefetch_related(
+                                    Prefetch(relation, authors),
+                                    Prefetch(relation, sliced_authors, to_attr="sliced"),
+                                )
+                            )
+                        self.assertEqual(sliced_authors.query.low_mark, start)
+                        self.assertEqual(sliced_authors.query.high_mark, stop)
+                        with self.assertNumQueries(0):
+                            for book in books:
+                                related = list(getattr(book, relation).all())
+                                expected = related[start:stop]
+                                if ordering:
+                                    self.assertEqual(book.sliced, expected)
+                                else:
+                                    self.assertEqual(len(book.sliced), len(expected))
+                                    self.assertTrue(set(book.sliced) <= set(related))
+
