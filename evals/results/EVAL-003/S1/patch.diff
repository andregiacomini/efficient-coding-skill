+@skipUnlessDBFeature("supports_over_clause")
 class PrefetchLimitTests(TestDataMixin, TestCase):
+    def test_slice_bounds(self):
+        authors = Author.objects.order_by("name")
+        for bounds in (slice(2), slice(1, 3), slice(3, 3), slice(10, None)):
+            query_count = 2 if bounds == slice(3, 3) else 3
+            with self.subTest(bounds=bounds), self.assertNumQueries(query_count):
+                books = list(
+                    Book.objects.prefetch_related(
+                        Prefetch("authors", authors),
+                        Prefetch("authors", authors[bounds], to_attr="authors_sliced"),
+                    )
+                )
+                for book in books:
+                    self.assertEqual(
+                        book.authors_sliced, list(book.authors.all())[bounds]
+                    )
+
+    def test_without_to_attr(self):
+        for relation in ("authors", "first_time_authors"):
+            with self.subTest(relation=relation):
+                authors = Author.objects.order_by("name")[1:3]
+                expected = [
+                    list(getattr(book, relation).order_by("name")[1:3])
+                    for book in Book.objects.all()
+                ]
+                with self.assertNumQueries(2):
+                    books = list(
+                        Book.objects.prefetch_related(Prefetch(relation, authors))
+                    )
+                with self.assertNumQueries(0):
+                    self.assertEqual(
+                        [list(getattr(book, relation).all()) for book in books], expected
+                    )
+                # Prefetching must not change the supplied queryset's slice.
+                self.assertEqual(authors.query.low_mark, 1)
+                self.assertEqual(authors.query.high_mark, 3)
+                with self.assertNumQueries(1):
+                    self.assertEqual(
+                        list(getattr(books[0], relation).all().all()), expected[0]
+                    )
+
+    def test_filtered_queryset(self):
+        authors = Author.objects.filter(first_book=self.book1).order_by("name")
+        with self.assertNumQueries(3):
