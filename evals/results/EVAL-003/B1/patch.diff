+@skipUnlessDBFeature("supports_over_clause")
 class PrefetchLimitTests(TestDataMixin, TestCase):
+    def test_without_to_attr(self):
+        for relation in ("authors", "first_time_authors"):
+            with self.subTest(relation=relation):
+                queryset = Author.objects.order_by("name")[1:2]
+                expected = {
+                    book.pk: list(getattr(book, relation).order_by("name"))[1:2]
+                    for book in Book.objects.all()
+                }
+                with self.assertNumQueries(2):
+                    books = list(
+                        Book.objects.prefetch_related(Prefetch(relation, queryset))
+                    )
+                with self.assertNumQueries(0):
+                    for book in books:
+                        self.assertEqual(
+                            list(getattr(book, relation).all()), expected[book.pk]
+                        )
+                self.assertEqual(queryset.query.low_mark, 1)
+                self.assertEqual(queryset.query.high_mark, 2)
+
+    def test_empty_slice(self):
+        with self.assertNumQueries(1):
+            books = list(
+                Book.objects.prefetch_related(
+                    Prefetch("authors", Author.objects.all()[:0], to_attr="examples")
+                )
+            )
+        for book in books:
+            self.assertEqual(book.examples, [])
+
+    def test_unsupported_backend(self):
+        msg = (
+            "Prefetching from a limited queryset is only supported on backends "
+            "that support window functions."
+        )
+        with mock.patch.object(connection.features, "supports_over_clause", False):
+            with self.assertRaisesMessage(NotSupportedError, msg):
+                list(
