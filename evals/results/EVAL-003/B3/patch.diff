+@skipUnlessDBFeature("supports_over_clause")
 class PrefetchLimitTests(TestDataMixin, TestCase):
+    def test_sliced_related_manager_cache(self):
+        for relation in ("authors", "first_time_authors"):
+            for limit in (slice(None, 2), slice(1, 2), slice(None, 0), slice(5, None)):
+                with self.subTest(relation=relation, limit=limit):
+                    authors = Author.objects.order_by("-name")[limit]
+                    expected = [
+                        list(getattr(book, relation).order_by("-name"))[limit]
+                        for book in Book.objects.all()
+                    ]
+                    with self.assertNumQueries(1 if limit.stop == 0 else 2):
+                        books = list(
+                            Book.objects.prefetch_related(Prefetch(relation, authors))
+                        )
+                    with self.assertNumQueries(0):
+                        self.assertEqual(
+                            [list(getattr(book, relation).all()) for book in books],
+                            expected,
+                        )
+                    self.assertEqual(authors.query.low_mark, limit.start or 0)
+                    self.assertEqual(authors.query.high_mark, limit.stop)
+
+    def test_filtered_slice(self):
+        authors = Author.objects.exclude(name="Anne").order_by("name")
+        with self.assertNumQueries(3):
+            books = list(
+                Book.objects.prefetch_related(
+                    Prefetch("authors", authors, to_attr="filtered_authors"),
+                    Prefetch("authors", authors[:1], to_attr="authors_sliced"),
+                )
+            )
+        for book in books:
+            self.assertEqual(book.authors_sliced, book.filtered_authors[:1])
+
+    def test_unsupported_backend(self):
+        msg = (
+            "Prefetching from a limited queryset is only supported on backends "
+            "that support window functions."
+        )
+        with mock.patch.object(connection.features, "supports_over_clause", False):
+            with self.assertRaisesMessage(NotSupportedError, msg):
+                list(
+                    Book.objects.prefetch_related(
+                        Prefetch("authors", Author.objects.all()[:1])
+                    )
+                )
