 class PrefetchLimitTests(TestDataMixin, TestCase):
+    def test_related_manager_cache(self):
+        for model, relation, related_queryset in (
+            (Book, "authors", Author.objects.order_by("name")),
+            (Author, "books", Book.objects.order_by("title")),
+            (Book, "first_time_authors", Author.objects.order_by("name")),
+        ):
+            with self.subTest(relation=relation):
+                expected = [
+                    list(
+                        getattr(obj, relation)
+                        .all()
+                        .order_by(*related_queryset.query.order_by)
+                    )[1:2]
+                    for obj in model.objects.all()
+                ]
+                sliced = related_queryset[1:2]
+                prefetch = Prefetch(relation, sliced)
+                for _ in range(2):
+                    with self.assertNumQueries(2):
+                        objects = list(model.objects.prefetch_related(prefetch))
+                    with self.assertNumQueries(0):
+                        self.assertEqual(
+                            [list(getattr(obj, relation).all()) for obj in objects],
+                            expected,
+                        )
+                    self.assertEqual(sliced.query.low_mark, 1)
+                    self.assertEqual(sliced.query.high_mark, 2)
+
