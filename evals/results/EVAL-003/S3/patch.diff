+@skipUnlessDBFeature("supports_over_clause")
 class PrefetchLimitTests(TestDataMixin, TestCase):
+    def test_slice_bounds(self):
+        for relation in ("authors", "first_time_authors"):
+            for bounds in (slice(3), slice(1, 3), slice(0), slice(2, 2), slice(10, 12)):
+                with self.subTest(relation=relation, bounds=bounds):
+                    authors = Author.objects.order_by("name")
+                    sliced_authors = authors[bounds]
+                    num_queries = 2 if bounds.stop == (bounds.start or 0) else 3
+                    with self.assertNumQueries(num_queries):
+                        books = list(
+                            Book.objects.prefetch_related(
+                                Prefetch(relation, authors, to_attr="all_authors"),
+                                Prefetch(
+                                    relation, sliced_authors, to_attr="sliced_authors"
+                                ),
+                            )
+                        )
+                    for book in books:
+                        self.assertEqual(book.sliced_authors, book.all_authors[bounds])
+                    self.assertEqual(
+                        (sliced_authors.query.low_mark, sliced_authors.query.high_mark),
+                        (bounds.start or 0, bounds.stop),
+                    )
+
+    def test_without_to_attr(self):
